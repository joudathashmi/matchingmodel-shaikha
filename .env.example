# Python matching engine (matching_v3.py)
# Copy to ".env" and fill in real values. Never commit ".env".

# Prefer Azure OpenAI for chat (enrichment, gate, narratives)
MISA_USE_AZURE_OPENAI=true
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Optional public OpenAI (embeddings). Leave unset to use TF-IDF fallback.
# OPENAI_API_KEY=

# Database (used by load_to_db_v3 / matching_v3 --source db)
MATCHDB_HOST=localhost
MATCHDB_PORT=5432
MATCHDB_NAME=matchmaking F
MATCHDB_USER=postgres
MATCHDB_PASSWORD=
