# Backend API — copy to ".env" and fill values. Never commit ".env".

NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Prisma / PostgreSQL
# Prefer a DB name WITHOUT spaces (e.g. matchmaking_f). If the name contains a
# space, URL-encoding (%20) can create a second literal DB named "matchmaking%20F"
# depending on the client — verify with: SELECT current_database();
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/matchmaking_f?schema=public
SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/matchmaking_f_shadow?schema=public

# Comma-separated browser origins allowed for CORS
CORS_ORIGIN=https://your-frontend.example.com

# Generate with: openssl rand -hex 64
JWT_ACCESS_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=7d

REFRESH_COOKIE_NAME=refreshToken
REFRESH_COOKIE_PATH=/
REFRESH_COOKIE_HTTP_ONLY=true
# Use "none" + HTTPS in production cross-site; "lax" for same-site
REFRESH_COOKIE_SAME_SITE=lax
REFRESH_COOKIE_SECURE=true

# Optional Nafath callback hardening
NAFATH_CALLBACK_API_KEY=

# Portfolio / Match desk chat (Azure OpenAI)
MISA_USE_AZURE_OPENAI=true
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# SSO / Nafath — implemented but off by default
ENABLE_SSO=false
SSO_PROVIDER=nafath
# Active Directory / Entra parameters are stored by admins in
# Settings → Active Directory (API: /api/identity-provider).
# Flip ENABLE_SSO only after those values are wired in auth.

# Password reset links (frontend origin).
# Reset URL is returned in the API only when NODE_ENV is not production
# AND PASSWORD_RESET_DEV_RETURN_LINK=true (never log the raw token).
APP_PUBLIC_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=60
# PASSWORD_RESET_DEV_RETURN_LINK=true
