# Frontend — copy to ".env" and fill values. Never commit ".env".

# API base URL (include /api). In production, point at the public API host.
REACT_APP_API_BASE_URL=https://your-api.example.com/api

# Local development alternative:
# REACT_APP_API_BASE_URL=http://localhost:4000/api

# SSO UI — wired but disabled unless backend ENABLE_SSO=true
REACT_APP_ENABLE_SSO=false
